# Port d'écoute de l'API (Railway/Vercel injectent PORT automatiquement)
PORT=3001

# Origines autorisées pour CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# Clé API 17TRACK (https://api.17track.net  compte gratuit 10k requêtes/mois).
# Obligatoire en production : sans clé, seuls les numéros DEMO fonctionnent.
TRACKING_API_KEY=
